# Copy to .env (local) or set on Render. Secrets marked "required in prod"
# must be set, or the app refuses to start when PHARMATRACK_ENV=production.

# --- Database -------------------------------------------------------------
# Leave unset for the local desktop SQLite file (pharmacy.db).
# Set to a PostgreSQL DSN to run the app against managed Postgres on Render:
#   DATABASE_URL=postgresql://user:password@host:5432/dbname
DATABASE_URL=

# --- Secrets (required when PHARMATRACK_ENV=production) --------------------
# Long random strings; generate 64 hex chars, e.g. `openssl rand -hex 32`.
JWT_SECRET_KEY=
SECRET_KEY=

# --- Environment -----------------------------------------------------------
# 'production' on Render (enforces SECRET_KEY/JWT_SECRET_KEY and disables
# the desktop pywebview path). Leave unset for local development.
PHARMATRACK_ENV=production

# --- CORS ------------------------------------------------------------------
# Comma-separated origins allowed to call the JSON API cross-origin.
# '*' opens it to any origin (needed for the customer app build).
CORS_ORIGINS=*

# --- APK download -----------------------------------------------------------
# Directory holding pharmafinder-v<VERSION>.apk. Defaults to static/downloads.
# PHARMATRACK_APK_DIR=

# --- Optional overrides (defaults shown) ------------------------------------
# PHARMATRACK_DB_PATH=pharmacy.db
# JWT_ACCESS_TOKEN_MINUTES=30
# JWT_REFRESH_TOKEN_DAYS=30